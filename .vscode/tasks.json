{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Auto Commit Watch",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-NoProfile",
        "-File",
        "${workspaceFolder}\\auto-commit-watch.ps1",
        "-Watch"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
